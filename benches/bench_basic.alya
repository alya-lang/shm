## Benchmark suite for shm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("shm Micro-Benchmarks")

    # Bench 1: config constructor - 100k iterations
    bench_start(runner, 100000)
    let i = 0
    while i < 100000
        pkg::default_config("bench", 4096, pkg::ShmOverflow.Overwrite)
        i += 1
    end
    bench_stop(runner, "default_config 100k")

    # Bench 2: send/recv roundtrip - 20k iterations
    pkg::unlink_channel("shm-bench")
    let writer = pkg::open_channel("shm-bench", 1048576, pkg::ShmOverflow.Overwrite)
    let reader = pkg::open_channel("shm-bench", 1048576, pkg::ShmOverflow.Overwrite)
    bench_start(runner, 20000)
    let j = 0
    while j < 20000
        pkg::send_text(writer, "ping", 1)
        pkg::recv_text(reader, 5000)
        j += 1
    end
    bench_stop(runner, "send/recv roundtrip 20k")
    pkg::close_channel(writer)
    pkg::close_channel(reader)
    pkg::unlink_channel("shm-bench")

    # Bench 3: open/close - 500 iterations
    bench_start(runner, 500)
    let k = 0
    while k < 500
        let ch = pkg::open_channel("shm-bench-open")
        pkg::close_channel(ch)
        k += 1
    end
    bench_stop(runner, "open/close 500")
    pkg::unlink_channel("shm-bench-open")

    bench_summary(runner)
end

main()
