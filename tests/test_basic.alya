## Test suite for shm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "std/os" as os
import "../src/lib.alya" as pkg

function padded(tag: string, width: int) -> string
    let s = tag
    while len(s) < width
        s += "."
    end
    return s
end

# Unique channel names per test run: POSIX segments outlive crashes,
# so a fixed name could collide with a stale segment from an older run.
function chan(base: string) -> string
    return base + "-" + str(os::get_pid())
end

function main()
    test_suite("shm Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Configuration & Validation
    # ═══════════════════════════════════════════════════════════
    let cfg = pkg::default_config("orders")
    runner_assert_str_eq(r, cfg.name, "orders", "config keeps channel name")
    runner_assert_eq(r, cfg.capacity, 1048576, "default capacity is 1MB")
    runner_assert_eq(r, cfg.overflow, pkg::ShmOverflow.Overwrite, "default overflow is Overwrite")
    runner_assert_eq(r, cfg.is_valid(), true, "default config is valid")

    let custom = pkg::default_config("jobs", 4096, pkg::ShmOverflow.Block)
    runner_assert_eq(r, custom.capacity, 4096, "custom capacity preserved")
    runner_assert_eq(r, custom.overflow, pkg::ShmOverflow.Block, "custom overflow preserved")
    runner_assert_eq(r, custom.is_valid(), true, "custom config is valid")
    runner_assert_str_eq(r, custom.summary(), "jobs (4096 bytes, overflow=1)", "config summary format")

    let tiny = pkg::default_config("tiny", 100)
    runner_assert_eq(r, tiny.is_valid(), false, "capacity below 1024 is invalid")

    let nameless = pkg::default_config("")
    runner_assert_eq(r, nameless.is_valid(), false, "empty name is invalid")

    runner_assert_eq(r, pkg::ShmOverflow.Overwrite, 0, "ShmOverflow.Overwrite == 0")
    runner_assert_eq(r, pkg::ShmOverflow.Block, 1, "ShmOverflow.Block == 1")

    let bad_open = false
    try
        pkg::open_channel("")
    catch e
        bad_open = true
    end
    runner_assert_eq(r, bad_open, true, "open rejects empty names")

    let garbage_open = false
    try
        pkg::open_channel("!!!")
    catch e
        garbage_open = true
    end
    runner_assert_eq(r, garbage_open, true, "open rejects unusable names")

    let small_open = false
    try
        pkg::open_channel("shm-test-small", 100)
    catch e
        small_open = true
    end
    runner_assert_eq(r, small_open, true, "open rejects tiny capacity")

    runner_assert_eq(r, pkg::close_channel(-1), 0, "close ignores invalid handles")
    runner_assert_eq(r, pkg::unlink_channel(""), 0, "unlink ignores empty names")

    # ═══════════════════════════════════════════════════════════
    # 2. Dual-Handle Send/Receive (shared segment)
    # ═══════════════════════════════════════════════════════════
    let echo_name = chan("shm-test-echo")
    pkg::unlink_channel(echo_name)
    let writer = pkg::open_channel(echo_name)
    let reader = pkg::open_channel(echo_name)
    runner_assert(r, writer >= 0, "writer handle opened")
    runner_assert(r, reader >= 0, "reader handle opened")

    let sent = pkg::send_text(writer, "hello", 42)
    runner_assert_eq(r, sent, 5, "send returns payload bytes")

    runner_assert_eq(r, pkg::pending_bytes(writer), 21, "16-byte header + 5 payload bytes pending")

    let text, kind = pkg::recv_text(reader, 2000)
    runner_assert_str_eq(r, text, "hello", "reader received payload")
    runner_assert_eq(r, kind, 42, "message type roundtrips")
    runner_assert_eq(r, pkg::pending_bytes(reader), 0, "channel drained")

    pkg::send_text(writer, "a:b:c")
    let colon_back, colon_kind = pkg::recv_text(reader, 2000)
    runner_assert_str_eq(r, colon_back, "a:b:c", "payload with colons survives")
    runner_assert_eq(r, colon_kind, 0, "default message type is 0")

    pkg::close_channel(writer)
    pkg::close_channel(reader)
    pkg::unlink_channel(echo_name)

    # ═══════════════════════════════════════════════════════════
    # 3. Receive Timeout on Empty Channel
    # ═══════════════════════════════════════════════════════════
    let empty_name = chan("shm-test-empty")
    pkg::unlink_channel(empty_name)
    let idle = pkg::open_channel(empty_name, 4096, pkg::ShmOverflow.Block)
    let no_msg, no_kind = pkg::shm_recv(idle, 65536, 200)
    runner_assert_eq(r, no_msg is null, true, "empty channel recv times out with null")
    pkg::close_channel(idle)
    pkg::unlink_channel(empty_name)

    # ═══════════════════════════════════════════════════════════
    # 4. Overwrite Drops Oldest Messages
    # ═══════════════════════════════════════════════════════════
    let ow_name = chan("shm-test-overwrite")
    pkg::unlink_channel(ow_name)
    let ow = pkg::open_channel(ow_name, 1024, pkg::ShmOverflow.Overwrite)
    let i = 0
    while i < 10
        pkg::send_text(ow, padded("msg-" + str(i), 200), i)
        i += 1
    end
    let drained = []
    let last_kind = -1
    while true
        let item, k = pkg::recv_text(ow, 200)
        if item is null
            break
        end
        drained.push(item)
        last_kind = k
    end
    runner_assert_eq(r, len(drained), 4, "1024-byte ring keeps last 4 of 10 records")
    runner_assert(r, drained[0] != padded("msg-0", 200), "oldest message was overwritten")
    runner_assert_str_eq(r, drained[len(drained) - 1], padded("msg-9", 200), "newest message survives")
    runner_assert_eq(r, last_kind, 9, "message type of last record preserved")
    pkg::close_channel(ow)
    pkg::unlink_channel(ow_name)

    # ═══════════════════════════════════════════════════════════
    # 5. Block Mode Times Out on Full Channel
    # ═══════════════════════════════════════════════════════════
    let bl_name = chan("shm-test-block")
    pkg::unlink_channel(bl_name)
    let bl = pkg::open_channel(bl_name, 1024, pkg::ShmOverflow.Block)
    pkg::send_text(bl, padded("fill", 900))
    let blocked = false
    try
        pkg::shm_send(bl, padded("overflow", 200), 0, 300)
    catch e
        blocked = true
    end
    runner_assert_eq(r, blocked, true, "block send times out on full channel")
    let fill_back, fill_kind = pkg::recv_text(bl, 2000)
    runner_assert_str_eq(r, fill_back, padded("fill", 900), "first message intact after block timeout")
    pkg::close_channel(bl)
    pkg::unlink_channel(bl_name)

    # ═══════════════════════════════════════════════════════════
    # 6. Capacity Mismatch & Oversize Messages
    # ═══════════════════════════════════════════════════════════
    let mm_name = chan("shm-test-mismatch")
    pkg::unlink_channel(mm_name)
    let first = pkg::open_channel(mm_name, 1024)
    let mismatch = false
    try
        pkg::open_channel(mm_name, 2048)
    catch e
        mismatch = true
    end
    runner_assert_eq(r, mismatch, true, "capacity mismatch with live channel throws")
    pkg::close_channel(first)
    pkg::unlink_channel(mm_name)
    let reopened = pkg::open_channel(mm_name, 2048)
    runner_assert(r, reopened >= 0, "reopen after unlink succeeds")
    pkg::close_channel(reopened)
    pkg::unlink_channel(mm_name)

    let hg_name = chan("shm-test-huge")
    pkg::unlink_channel(hg_name)
    let hg = pkg::open_channel(hg_name, 1024)
    let huge = false
    try
        pkg::send_text(hg, padded("x", 2000))
    catch e
        huge = true
    end
    runner_assert_eq(r, huge, true, "message larger than capacity throws")
    pkg::close_channel(hg)
    pkg::unlink_channel(hg_name)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
