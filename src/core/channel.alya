## shm Shared-Memory Channel
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Framing-aware wrappers over the bundled native ring buffer (`c/shm.c`).
## Two handles opened on the same name share one segment, so a sender and
## a receiver can live in the same process (tests, demos) or in two
## processes (real deployments) with identical calls.

import "std/mem"
import "../types.alya"
import "../ffi.alya"

## Opens (or joins) a shared-memory channel.
##
## The first opener creates and sizes the segment; later openers with the
## same name and capacity join it. A capacity mismatch with the live
## segment throws `ShmError` (unlink the stale channel first).
##
## ### Parameters
## - `name`: Logical channel name.
## - `capacity`: Data area size in bytes (defaults to 1048576, min 1024).
## - `overflow`: `ShmOverflow` value (defaults to Overwrite).
## - `polling_ms`: Receiver poll slice in milliseconds (defaults to 10).
##
## ### Returns
## Channel slot handle (>= 0).
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_open(name: string, capacity: int = 1048576, overflow: int = ShmOverflow.Overwrite, polling_ms: int = 10) -> int
    if name is null or name == ""
        throw ShmError { message: "shm: invalid channel name", code: 1 }
    end
    let cap = capacity
    if cap <= 0
        cap = 1048576
    end
    if cap < 1024
        throw ShmError { message: "shm: capacity too small (min 1024 bytes)", code: 1 }
    end
    if overflow != ShmOverflow.Overwrite and overflow != ShmOverflow.Block
        throw ShmError { message: "shm: invalid overflow mode", code: 1 }
    end
    let poll = polling_ms
    if poll <= 0
        poll = 10
    end
    let slot = shm_open_channel(name, cap, overflow, poll)
    if slot < 0
        throw ShmError { message: shm_last_error(), code: 2 }
    end
    return slot
end

## Opens a channel from a `ShmConfig` record.
##
## ### Parameters
## - `cfg`: Channel configuration.
##
## ### Returns
## Channel slot handle (>= 0).
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_open_config(cfg) -> int
    if cfg is null or shm_config_is_valid(cfg) == false
        throw ShmError { message: "shm: invalid channel configuration", code: 1 }
    end
    return shm_open(cfg.name, cfg.capacity, cfg.overflow, cfg.polling_ms)
end

## Closes a channel slot, ignoring invalid handles.
##
## The shared segment survives until every handle closes (plus an
## explicit `shm_unlink` on POSIX when no opener remains).
##
## ### Parameters
## - `slot`: Channel slot handle to close.
##
## ### Returns
## Always 0.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_close(slot: int) -> int
    if slot < 0
        return 0
    end
    shm_close_channel(slot)
    return 0
end

## Removes a stale channel segment by name.
##
## Needed on POSIX when a crashed run leaves a segment behind (a later
## open with a different capacity would otherwise mismatch). No-op on
## Windows, where names vanish with the last handle.
##
## ### Parameters
## - `name`: Logical channel name.
##
## ### Returns
## Always 0.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_unlink(name: string) -> int
    if name is null or name == ""
        return 0
    end
    shm_unlink_channel(name)
    return 0
end

## Sends one message into the channel.
##
## Payloads are byte-sized (UTF-8 safe); anything that fits the ring
## capacity is accepted, larger payloads throw `ShmError`.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `payload`: Text payload (null becomes "").
## - `msg_type`: Application message type (defaults to 0).
## - `timeout_ms`: Maximum wait in Block mode (defaults to 5000).
##
## ### Returns
## Payload bytes written.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_send(slot: int, payload, msg_type: int = 0, timeout_ms: int = 5000) -> int
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let body = payload
    if body is null
        body = ""
    end
    let t = timeout_ms
    if t < 0
        t = 0
    end
    let n = shm_send_message(slot, body, msg_type, t)
    if n == -2
        throw ShmError { message: shm_last_error(), code: 4 }
    end
    if n < 0
        throw ShmError { message: shm_last_error(), code: 5 }
    end
    return n
end

# Drains one message from the channel with (consume = 1) or without
# (consume = 0) advancing the read position. Reader 0 is the legacy
# default stream; readers 1..7 are broadcast subscribers.
# Returns (payload, msg_type) with null payload on timeout.
function drain_message(slot: int, max_bytes: int, timeout_ms: int, consume: int, reader: int = 0)
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let limit = max_bytes
    if limit <= 0
        limit = 65536
    end
    let t = timeout_ms
    if t < 0
        t = 0
    end
    let need = shm_next_message_len(slot)
    let size = limit
    if need > size
        size = need
    end
    if size <= 0
        size = limit
    end
    let buf = alloc_mem(size + 1)
    let type_slot = alloc_zeroed(8)
    let attempt = 0
    while attempt < 2
        let n = -2
        if reader == 0
            if consume == 1
                n = shm_recv_message(slot, buf, size, type_slot, t)
            else
                n = shm_peek_message(slot, buf, size, type_slot, t)
            end
        else
            if consume == 1
                n = shm_recv_reader(slot, reader, buf, size, type_slot, t)
            else
                n = shm_peek_reader(slot, reader, buf, size, type_slot, t)
            end
        end
        if n == -2
            free_mem(buf)
            free_mem(type_slot)
            return null, 0
        end
        if n == -3
            free_mem(buf)
            free_mem(type_slot)
            let retry_need = shm_next_message_len(slot)
            if reader != 0
                retry_need = shm_reader_message_len(slot, reader)
            end
            size = limit
            if retry_need > size
                size = retry_need
            end
            buf = alloc_mem(size + 1)
            type_slot = alloc_zeroed(8)
            attempt += 1
            continue
        end
        if n < 0
            free_mem(buf)
            free_mem(type_slot)
            throw ShmError { message: shm_last_error(), code: 5 }
        end
        write_byte(buf, n, 0)
        let payload = string_clone(to_string(buf))
        let kind = read_int(type_slot, 0)
        free_mem(buf)
        free_mem(type_slot)
        return payload, kind
    end
    free_mem(buf)
    free_mem(type_slot)
    throw ShmError { message: "shm: receive buffer too small", code: 5 }
end

## Receives the next message from the channel.
##
## Returns a `(payload, msg_type)` tuple; the payload is null on timeout
## so callers can tell "no message yet" apart from an empty message.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `max_bytes`: Initial receive buffer in bytes (grows as needed, defaults to 65536).
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload on timeout.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_recv(slot: int, max_bytes: int = 65536, timeout_ms: int = 5000)
    return drain_message(slot, max_bytes, timeout_ms, 1)
end

## Reads the next message without consuming it.
##
## The message stays queued for a later `shm_recv`; counters are
## untouched. Returns `(payload, msg_type)` with null payload on timeout.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `max_bytes`: Initial receive buffer in bytes (grows as needed, defaults to 65536).
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload on timeout.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_peek(slot: int, max_bytes: int = 65536, timeout_ms: int = 5000)
    return drain_message(slot, max_bytes, timeout_ms, 0)
end

## Tries to receive without waiting.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `max_bytes`: Initial receive buffer in bytes (defaults to 65536).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload when empty.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_try_recv(slot: int, max_bytes: int = 65536)
    return drain_message(slot, max_bytes, 0, 1)
end

## Tries to send without waiting.
##
## Never blocks: reports -1 instead of sending when the channel is full
## or any fault occurs.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `payload`: Text payload (null becomes "").
## - `msg_type`: Application message type (defaults to 0).
##
## ### Returns
## Payload bytes written, or -1 when the send cannot complete.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_try_send(slot: int, payload, msg_type: int = 0) -> int
    try
        return shm_send(slot, payload, msg_type, 0)
    catch e
        return -1
    end
end

## Returns the bytes currently waiting in the channel.
##
## ### Parameters
## - `slot`: Channel slot handle.
##
## ### Returns
## Buffered byte count, or -1 for invalid handles.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_available(slot: int) -> int
    if slot < 0
        return -1
    end
    return shm_available_bytes(slot)
end

## Reads lifetime counters for the channel.
##
## Counters accumulate across every handle until the segment is
## unlinked and recreated.
##
## ### Parameters
## - `slot`: Channel slot handle.
##
## ### Returns
## `ShmStats` with sent, received, and dropped totals.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_stats(slot: int) -> ShmStats
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let out = alloc_zeroed(24)
    let rc = shm_channel_stats(slot, out)
    if rc != 0
        free_mem(out)
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let st = ShmStats { sent: read_int(out, 0), received: read_int(out, 8), dropped: read_int(out, 16) }
    free_mem(out)
    return st
end

## Sends raw bytes (binary-safe, NUL bytes preserved).
##
## Elements outside 0-255 throw `ShmError`; an empty or null array sends
## a zero-length message.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `bytes`: Integer array payload (each element 0-255).
## - `msg_type`: Application message type (defaults to 0).
## - `timeout_ms`: Maximum wait in Block mode (defaults to 5000).
##
## ### Returns
## Payload bytes written.
##
## Requires the `bytes` feature (default-on).
@cfg(feature = "bytes")
pub function shm_send_bytes(slot: int, bytes, msg_type: int = 0, timeout_ms: int = 5000) -> int
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let n = 0
    if bytes is not null
        n = len(bytes)
    end
    if n == 0
        return shm_send(slot, "", msg_type, timeout_ms)
    end
    let t = timeout_ms
    if t < 0
        t = 0
    end
    let buf = alloc_mem(n)
    let i = 0
    while i < n
        let b = bytes[i]
        if b < 0 or b > 255
            free_mem(buf)
            throw ShmError { message: "shm: byte value out of range (0-255)", code: 1 }
        end
        write_byte(buf, i, b)
        i += 1
    end
    let sent = shm_send_raw(slot, buf, n, msg_type, t)
    free_mem(buf)
    if sent == -2
        throw ShmError { message: shm_last_error(), code: 4 }
    end
    if sent < 0
        throw ShmError { message: shm_last_error(), code: 5 }
    end
    return sent
end

## Subscribes a broadcast reader to the channel.
##
## The reader starts at the oldest buffered message, so a fresh
## subscriber receives channel history. Up to 7 subscribers share one
## channel alongside the legacy default stream.
##
## ### Parameters
## - `slot`: Channel slot handle.
##
## ### Returns
## Reader id (1-7) for `shm_recv_for` and friends.
##
## Requires the `broadcast` feature (default-on).
@cfg(feature = "broadcast")
pub function shm_subscribe(slot: int) -> int
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let id = shm_subscribe_reader(slot)
    if id < 0
        throw ShmError { message: shm_last_error(), code: 6 }
    end
    return id
end

## Removes a broadcast reader from the channel.
##
## Idempotent: unsubscribing twice succeeds. Reader ids 1-7 only.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `reader`: Reader id from `shm_subscribe`.
##
## ### Returns
## Always 0.
##
## Requires the `broadcast` feature (default-on).
@cfg(feature = "broadcast")
pub function shm_unsubscribe(slot: int, reader: int) -> int
    if slot < 0
        return 0
    end
    if reader < 1 or reader > 7
        throw ShmError { message: "shm: invalid reader id", code: 1 }
    end
    shm_unsubscribe_reader(slot, reader)
    return 0
end

## Receives the next message for a broadcast reader.
##
## Every subscriber observes every message until pressure drops the
## oldest ones (Overwrite) or the slowest reader stalls the writer
## (Block). Returns `(payload, msg_type)` with null payload on timeout.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `reader`: Reader id from `shm_subscribe`.
## - `max_bytes`: Initial receive buffer in bytes (grows as needed, defaults to 65536).
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload on timeout.
##
## Requires the `broadcast` feature (default-on).
@cfg(feature = "broadcast")
pub function shm_recv_for(slot: int, reader: int, max_bytes: int = 65536, timeout_ms: int = 5000)
    return drain_message(slot, max_bytes, timeout_ms, 1, reader)
end

## Reads the next message for a reader without consuming it.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `reader`: Reader id from `shm_subscribe`.
## - `max_bytes`: Initial receive buffer in bytes (grows as needed, defaults to 65536).
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload on timeout.
##
## Requires the `broadcast` feature (default-on).
@cfg(feature = "broadcast")
pub function shm_peek_for(slot: int, reader: int, max_bytes: int = 65536, timeout_ms: int = 5000)
    return drain_message(slot, max_bytes, timeout_ms, 0, reader)
end

## Returns the bytes waiting for one broadcast reader.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `reader`: Reader id from `shm_subscribe`.
##
## ### Returns
## Buffered byte count for that reader, or -1 on faults.
##
## Requires the `broadcast` feature (default-on).
@cfg(feature = "broadcast")
pub function shm_reader_available(slot: int, reader: int) -> int
    if slot < 0
        return -1
    end
    if reader < 1 or reader > 7
        return -1
    end
    return shm_reader_available_bytes(slot, reader)
end

## Receives raw bytes (binary-safe, NUL bytes preserved).
##
## Returns a `(bytes, msg_type)` tuple; the array is null on timeout so
## callers can tell "no message yet" apart from an empty message.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `max_bytes`: Initial receive buffer in bytes (grows as needed, defaults to 65536).
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(bytes, msg_type)` tuple with null array on timeout.
##
## Requires the `bytes` feature (default-on).
@cfg(feature = "bytes")
pub function shm_recv_bytes(slot: int, max_bytes: int = 65536, timeout_ms: int = 5000)
    if slot < 0
        throw ShmError { message: "shm: invalid channel slot", code: 3 }
    end
    let limit = max_bytes
    if limit <= 0
        limit = 65536
    end
    let t = timeout_ms
    if t < 0
        t = 0
    end
    let need = shm_next_message_len(slot)
    let size = limit
    if need > size
        size = need
    end
    if size <= 0
        size = limit
    end
    let buf = alloc_mem(size + 1)
    let type_slot = alloc_zeroed(8)
    let attempt = 0
    while attempt < 2
        let n = shm_recv_message(slot, buf, size, type_slot, t)
        if n == -2
            free_mem(buf)
            free_mem(type_slot)
            return null, 0
        end
        if n == -3
            free_mem(buf)
            free_mem(type_slot)
            let retry_need = shm_next_message_len(slot)
            size = limit
            if retry_need > size
                size = retry_need
            end
            buf = alloc_mem(size + 1)
            type_slot = alloc_zeroed(8)
            attempt += 1
            continue
        end
        if n < 0
            free_mem(buf)
            free_mem(type_slot)
            throw ShmError { message: shm_last_error(), code: 5 }
        end
        let out = []
        let i = 0
        while i < n
            out.push(read_byte(buf, i))
            i += 1
        end
        let kind = read_int(type_slot, 0)
        free_mem(buf)
        free_mem(type_slot)
        return out, kind
    end
    free_mem(buf)
    free_mem(type_slot)
    throw ShmError { message: "shm: receive buffer too small", code: 5 }
end
