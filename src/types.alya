## shm Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines channel configuration, overflow policy, and error models for
## shared-memory ring-buffer messaging.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Policy applied when a send does not fit the remaining ring space.
##
## `Overwrite` drops the oldest messages to make room; `Block` waits
## until the reader frees space or the timeout expires.
pub enum ShmOverflow
    Overwrite = 0,
    Block = 1
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Configuration for opening a shared-memory channel.
##
## ### Fields
## - `name`: Logical channel name (`[A-Za-z0-9_-]`, up to 32 chars).
## - `capacity`: Data area size in bytes (minimum 1024).
## - `overflow`: Active `ShmOverflow` value.
## - `polling_ms`: Receiver poll slice in milliseconds.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub struct ShmConfig
    name: string,
    capacity: int,
    overflow: int,
    polling_ms: int
end

## Error thrown for invalid configuration and channel I/O faults.
##
## ### Fields
## - `message`: Human-readable failure description.
## - `code`: Numeric failure category.
pub struct ShmError
    message: string,
    code: int
end

## Lifetime counters for one channel, read from the shared header.
##
## Counters accumulate across every handle on the channel until the
## segment is unlinked and recreated.
##
## ### Fields
## - `sent`: Messages accepted by the ring.
## - `received`: Messages consumed by receivers.
## - `dropped`: Messages discarded by the Overwrite policy.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub struct ShmStats
    sent: int,
    received: int,
    dropped: int
end

# ───────────────────────────────────────────────────────────────
# Constructors & Validation
# ───────────────────────────────────────────────────────────────

## Creates a channel configuration with sensible defaults.
##
## ### Parameters
## - `name`: Logical channel name.
## - `capacity`: Data area size in bytes (defaults to 1048576).
## - `overflow`: `ShmOverflow` value (defaults to Overwrite).
## - `polling_ms`: Receiver poll slice in milliseconds (defaults to 10).
##
## ### Returns
## Initialized `ShmConfig`.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_config(name: string, capacity: int = 1048576, overflow: int = ShmOverflow.Overwrite, polling_ms: int = 10) -> ShmConfig
    let n = name
    if n is null
        n = ""
    end
    let cap = capacity
    if cap <= 0
        cap = 1048576
    end
    let poll = polling_ms
    if poll <= 0
        poll = 10
    end
    return ShmConfig { name: n, capacity: cap, overflow: overflow, polling_ms: poll }
end

## Returns true when the configuration can open a channel.
##
## ### Parameters
## - `cfg`: Configuration to validate.
##
## ### Returns
## True for a non-empty name, capacity >= 1024, and a known overflow mode.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function shm_config_is_valid(cfg) -> bool
    if cfg is null
        return false
    end
    if cfg.name is null or cfg.name == ""
        return false
    end
    if cfg.capacity < 1024
        return false
    end
    if cfg.overflow != ShmOverflow.Overwrite and cfg.overflow != ShmOverflow.Block
        return false
    end
    return true
end

# ───────────────────────────────────────────────────────────────
# Struct Methods
# ───────────────────────────────────────────────────────────────

## Returns true when this configuration can open a channel.
##
## ### Parameters
## - `self`: The target `ShmConfig` instance.
##
## ### Returns
## True when valid, else false.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function ShmConfig.is_valid(self: ShmConfig) -> bool
    return shm_config_is_valid(self)
end

## Returns a single-line summary of the configuration.
##
## ### Parameters
## - `self`: The target `ShmConfig` instance.
##
## ### Returns
## Formatted `"name (capacity bytes, overflow=N)"` summary.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function ShmConfig.summary(self: ShmConfig) -> string
    return f"{self.name} ({self.capacity} bytes, overflow={self.overflow})"
end

## Returns the total messages accepted by the channel.
##
## ### Parameters
## - `self`: The target `ShmStats` instance.
##
## ### Returns
## Sum of received and dropped messages (what came out plus what was lost).
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function ShmStats.accounted(self: ShmStats) -> int
    return self.received + self.dropped
end

## Returns a single-line summary of the counters.
##
## ### Parameters
## - `self`: The target `ShmStats` instance.
##
## ### Returns
## Formatted `"sent=N received=N dropped=N"` summary.
##
## Requires the `core` feature (default-on).
@cfg(feature = "core")
pub function ShmStats.summary(self: ShmStats) -> string
    return f"sent={self.sent} received={self.received} dropped={self.dropped}"
end
