## shm Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary public entry point for shared-memory ring-buffer messaging.

import "./types.alya"
import "./core/channel.alya"

# ───────────────────────────────────────────────────────────────
# Channel Lifecycle
# ───────────────────────────────────────────────────────────────

## Opens (or joins) a shared-memory channel.
##
## ### Parameters
## - `name`: Logical channel name.
## - `capacity`: Data area size in bytes (defaults to 1048576, min 1024).
## - `overflow`: `ShmOverflow` value (defaults to Overwrite).
##
## ### Returns
## Channel slot handle (>= 0).
##
## ### Examples
## ```alya
## let ch = open_channel("orders")
## ```
pub function open_channel(name: string, capacity: int = 1048576, overflow: int = ShmOverflow.Overwrite) -> int
    return shm_open(name, capacity, overflow)
end

## Opens a channel from a `ShmConfig` record.
##
## ### Parameters
## - `cfg`: Channel configuration (see `default_config`).
##
## ### Returns
## Channel slot handle (>= 0).
pub function open_config(cfg) -> int
    return shm_open_config(cfg)
end

## Creates a channel configuration with sensible defaults.
##
## ### Parameters
## - `name`: Logical channel name.
## - `capacity`: Data area size in bytes (defaults to 1048576).
## - `overflow`: `ShmOverflow` value (defaults to Overwrite).
##
## ### Returns
## Initialized `ShmConfig`.
pub function default_config(name: string, capacity: int = 1048576, overflow: int = ShmOverflow.Overwrite) -> ShmConfig
    return shm_config(name, capacity, overflow)
end

## Closes a channel slot, ignoring invalid handles.
##
## ### Parameters
## - `slot`: Channel slot handle to close.
##
## ### Returns
## Always 0.
pub function close_channel(slot: int) -> int
    return shm_close(slot)
end

## Removes a stale channel segment by name.
##
## ### Parameters
## - `name`: Logical channel name.
##
## ### Returns
## Always 0.
pub function unlink_channel(name: string) -> int
    return shm_unlink(name)
end

# ───────────────────────────────────────────────────────────────
# Messaging
# ───────────────────────────────────────────────────────────────

## Sends one message into the channel.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `payload`: Text payload (null becomes "").
## - `msg_type`: Application message type (defaults to 0).
##
## ### Returns
## Payload bytes written.
##
## ### Examples
## ```alya
## send_text(ch, "hello", 1)
## ```
pub function send_text(slot: int, payload, msg_type: int = 0) -> int
    return shm_send(slot, payload, msg_type)
end

## Receives the next message from the channel.
##
## ### Parameters
## - `slot`: Channel slot handle.
## - `timeout_ms`: Maximum wait in milliseconds (defaults to 5000).
##
## ### Returns
## `(payload, msg_type)` tuple with null payload on timeout.
##
## ### Examples
## ```alya
## let text, kind = recv_text(ch, 1000)
## ```
pub function recv_text(slot: int, timeout_ms: int = 5000)
    return shm_recv(slot, 65536, timeout_ms)
end

## Returns the bytes currently waiting in the channel.
##
## ### Parameters
## - `slot`: Channel slot handle.
##
## ### Returns
## Buffered byte count, or -1 for invalid handles.
pub function pending_bytes(slot: int) -> int
    return shm_available(slot)
end
