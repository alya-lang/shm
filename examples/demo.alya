## Example usage and walkthrough for shm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

@cfg(feature = "core")
function demo_core()
    # ───────────────────────────────────────────────────────────
    # 1. Configuration
    # ───────────────────────────────────────────────────────────
    say "--- 1. Configuration ---"
    let cfg = pkg::default_config("demo", 4096, pkg::ShmOverflow.Overwrite)
    say "Config: " + cfg.summary()
    say "Valid:  " + str(cfg.is_valid())
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Dual-Handle Echo (shared segment, one process)
    # ───────────────────────────────────────────────────────────
    say "--- 2. Dual-Handle Echo ---"
    pkg::unlink_channel("shm-demo-echo")
    let writer = pkg::open_channel("shm-demo-echo")
    let reader = pkg::open_channel("shm-demo-echo")
    pkg::send_text(writer, "ping", 7)
    say "Pending: " + str(pkg::pending_bytes(writer)) + " bytes"
    let text, kind = pkg::recv_text(reader, 2000)
    say "Got:     " + text + " (type=" + str(kind) + ")"
    pkg::close_channel(writer)
    pkg::close_channel(reader)
    pkg::unlink_channel("shm-demo-echo")
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Overwrite Under Pressure
    # ───────────────────────────────────────────────────────────
    say "--- 3. Overwrite Under Pressure ---"
    pkg::unlink_channel("shm-demo-pressure")
    let ch = pkg::open_channel("shm-demo-pressure", 1024, pkg::ShmOverflow.Overwrite)
    let i = 0
    while i < 10
        let payload = "event-" + str(i)
        while len(payload) < 200
            payload += "."
        end
        pkg::send_text(ch, payload, i)
        i += 1
    end
    say "Sent 10 events into a 1024-byte ring."
    let shown = 0
    while true
        let item, k = pkg::recv_text(ch, 200)
        if item is null
            break
        end
        if shown < 2
            say "Kept:    " + item + " (type=" + str(k) + ")"
        end
        shown += 1
    end
    say "Survived: " + str(shown) + " newest events."
    pkg::close_channel(ch)
    pkg::unlink_channel("shm-demo-pressure")
    say ""

    # ───────────────────────────────────────────────────────────
    # 4a. Statistics
    # ───────────────────────────────────────────────────────────
    say "--- 4a. Statistics ---"
    pkg::unlink_channel("shm-demo-stats")
    let st_ch = pkg::open_channel("shm-demo-stats")
    pkg::send_text(st_ch, "alpha", 1)
    let st = pkg::channel_stats(st_ch)
    say "Stats: " + st.summary()
    let first, first_kind = pkg::recv_text(st_ch, 2000)
    say "Text:  " + first + " (type=" + str(first_kind) + ")"
    pkg::close_channel(st_ch)
    pkg::unlink_channel("shm-demo-stats")
    say ""

end

@cfg(not(feature = "core"))
function demo_core()
end

@cfg(feature = "bytes")
function demo_bytes()
    # ───────────────────────────────────────────────────────────
    # 4b. Binary Bytes
    # ───────────────────────────────────────────────────────────
    say "--- 4b. Binary Bytes ---"
    pkg::unlink_channel("shm-demo-bytes")
    let ch = pkg::open_channel("shm-demo-bytes")
    pkg::send_bytes(ch, [72, 0, 105], 9)
    let raw, raw_kind = pkg::recv_bytes(ch, 2000)
    say "Bytes: len=" + str(len(raw)) + " type=" + str(raw_kind) + " zero_ok=" + str(raw[1] == 0)
    pkg::close_channel(ch)
    pkg::unlink_channel("shm-demo-bytes")
    say ""

end

@cfg(not(feature = "bytes"))
function demo_bytes()
end

@cfg(feature = "broadcast")
function demo_broadcast()
    # ───────────────────────────────────────────────────────────
    # 5. Broadcast Fan-Out
    # ───────────────────────────────────────────────────────────
    say "--- 5. Broadcast Fan-Out ---"
    pkg::unlink_channel("shm-demo-fanout")
    let fan = pkg::open_channel("shm-demo-fanout")
    pkg::send_text(fan, "news", 5)
    let s1 = pkg::subscribe(fan)
    let s2 = pkg::subscribe(fan)
    let n1, k1 = pkg::recv_for(fan, s1, 2000)
    let n2, k2 = pkg::recv_for(fan, s2, 2000)
    say "Sub1: " + n1 + " (type=" + str(k1) + ")"
    say "Sub2: " + n2 + " (type=" + str(k2) + ")"
    pkg::close_channel(fan)
    pkg::unlink_channel("shm-demo-fanout")
    say ""

end

@cfg(not(feature = "broadcast"))
function demo_broadcast()
end

@cfg(feature = "rpc")
function demo_rpc()
    # ───────────────────────────────────────────────────────────
    # 6. Request/Reply Call
    # ───────────────────────────────────────────────────────────
    say "--- 6. Request/Reply Call ---"
    pkg::unlink_channel("shm-demo-req")
    pkg::unlink_channel("shm-demo-rep")
    let req = pkg::open_channel("shm-demo-req")
    let rep = pkg::open_channel("shm-demo-rep")
    let rep_reader = pkg::open_channel("shm-demo-rep")
    pkg::shm_send(req, "compute:6*7", 7, 5000)
    let asked, asked_kind = pkg::shm_recv(req, 65536, 2000)
    say "Service got: " + asked + " (type=" + str(asked_kind) + ")"
    pkg::shm_send(rep, "answer:42", asked_kind, 5000)
    let answer, answer_kind = pkg::call_text(req, rep_reader, "ping", 1, 2000)
    say "Call got:    " + answer + " (type=" + str(answer_kind) + ")"
    pkg::close_channel(req)
    pkg::close_channel(rep)
    pkg::close_channel(rep_reader)
    pkg::unlink_channel("shm-demo-req")
    pkg::unlink_channel("shm-demo-rep")
    say ""

end

@cfg(not(feature = "rpc"))
function demo_rpc()
end

function main()
    say "=== shm Package Showcase ==="
    say ""

    demo_core()
    demo_bytes()
    demo_broadcast()
    demo_rpc()

    say "Done!"
end

main()
