## Example usage and walkthrough for shm
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== shm Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Configuration
    # ───────────────────────────────────────────────────────────
    say "--- 1. Configuration ---"
    let cfg = pkg::default_config("demo", 4096, pkg::ShmOverflow.Overwrite)
    say "Config: " + cfg.summary()
    say "Valid:  " + str(cfg.is_valid())
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Dual-Handle Echo (shared segment, one process)
    # ───────────────────────────────────────────────────────────
    say "--- 2. Dual-Handle Echo ---"
    pkg::unlink_channel("shm-demo-echo")
    let writer = pkg::open_channel("shm-demo-echo")
    let reader = pkg::open_channel("shm-demo-echo")
    pkg::send_text(writer, "ping", 7)
    say "Pending: " + str(pkg::pending_bytes(writer)) + " bytes"
    let text, kind = pkg::recv_text(reader, 2000)
    say "Got:     " + text + " (type=" + str(kind) + ")"
    pkg::close_channel(writer)
    pkg::close_channel(reader)
    pkg::unlink_channel("shm-demo-echo")
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Overwrite Under Pressure
    # ───────────────────────────────────────────────────────────
    say "--- 3. Overwrite Under Pressure ---"
    pkg::unlink_channel("shm-demo-pressure")
    let ch = pkg::open_channel("shm-demo-pressure", 1024, pkg::ShmOverflow.Overwrite)
    let i = 0
    while i < 10
        let payload = "event-" + str(i)
        while len(payload) < 200
            payload += "."
        end
        pkg::send_text(ch, payload, i)
        i += 1
    end
    say "Sent 10 events into a 1024-byte ring."
    let shown = 0
    while true
        let item, k = pkg::recv_text(ch, 200)
        if item is null
            break
        end
        if shown < 2
            say "Kept:    " + item + " (type=" + str(k) + ")"
        end
        shown += 1
    end
    say "Survived: " + str(shown) + " newest events."
    pkg::close_channel(ch)
    pkg::unlink_channel("shm-demo-pressure")
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Statistics & Binary Bytes
    # ───────────────────────────────────────────────────────────
    say "--- 4. Statistics & Binary Bytes ---"
    pkg::unlink_channel("shm-demo-stats")
    let st_ch = pkg::open_channel("shm-demo-stats")
    pkg::send_text(st_ch, "alpha", 1)
    pkg::send_bytes(st_ch, [72, 0, 105], 9)
    let st = pkg::channel_stats(st_ch)
    say "Stats: " + st.summary()
    let first, first_kind = pkg::recv_text(st_ch, 2000)
    say "Text:  " + first + " (type=" + str(first_kind) + ")"
    let raw, raw_kind = pkg::recv_bytes(st_ch, 2000)
    say "Bytes: len=" + str(len(raw)) + " type=" + str(raw_kind) + " zero_ok=" + str(raw[1] == 0)
    pkg::close_channel(st_ch)
    pkg::unlink_channel("shm-demo-stats")
    say ""
    say "Done!"
end

main()
